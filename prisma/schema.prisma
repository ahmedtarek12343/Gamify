// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  clerkId String @unique
  email String @unique
  imageUrl String?
  firstName String
  lastName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  wishlists Wishlist[]
  comments Comment[]
  gameStatuses GameStatus[]
  commentLikes CommentLikes[]

  @@map("users")
}

enum Status {
  Playing
  Completed
  OnHold
  Dropped
  PlanToPlay
}


model Wishlist{
  id String @id @default(uuid())
  userId String 
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  gameId String
  gameName String
  gameImage String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([userId, gameId])
  @@map("wishlists")
}

model Comment{
  id String @id @default(uuid())
  userId String 
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  gameId String
  comment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes CommentLikes[]

  @@map("comments")
}

model CommentLikes{
  id String @id @default(uuid())
  userId String 
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  commentId String
  comment Comment @relation(fields: [commentId],references: [id],onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, commentId])
  @@index([userId, commentId])
  @@map("commentLikes")
}

model Order{
  id String @id @default(uuid())
  userId String 
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  orderItems OrderItem[]
  totalAmount Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem{
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId],references: [id],onDelete: Cascade)
  gameId String
  gameName String
  gameImage String
  gamePrice Float
  gameQuantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orderItems")
}

model GameStatus{
  id String @id @default(uuid())
  userId String 
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  gameId String
  gameName String
  gameImage String
  status Status
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([userId, gameId])
  @@map("gameStatuses")
}